<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@android:color/white"
    tools:context=".MeasurementActivity">

    <!-- This Toolbar is now always visible -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/measurement_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:titleTextColor="@android:color/black"
        app:title="" /> <!-- Start with an empty title -->

    <!-- Container for Card Selection (Visible by default) -->
    <LinearLayout
        android:id="@+id/layout_card_selection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Measurement Type"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"
            android:textColor="@android:color/black"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_length"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#F2F2F2"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Length"
                    android:textColor="@android:color/black"
                    android:layout_gravity="center"
                    android:textSize="16sp"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_weight"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#F2F2F2"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weight"
                    android:textColor="@android:color/black"
                    android:layout_gravity="center"
                    android:textSize="16sp"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_volume"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#F2F2F2"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Volume"
                    android:textColor="@android:color/black"
                    android:layout_gravity="center"
                    android:textSize="16sp"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <!-- Container for Conversion UI (Initially hidden) -->
    <LinearLayout
        android:id="@+id/layout_conversion_ui"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible"> <!-- tools:visibility makes it visible in preview -->

        <!-- We need to subtract the toolbar height from the available space -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/input_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0"
                android:textColorHint="#BDBDBD"
                android:textColor="@android:color/black"
                android:gravity="end"
                android:textSize="48sp"
                android:maxLines="1"
                android:ellipsize="start"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <Spinner
                    android:id="@+id/spinner_from_unit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#F2F2F2"
                    android:padding="8dp"
                    android:layout_marginEnd="8dp" />

                <Spinner
                    android:id="@+id/spinner_to_unit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#F2F2F2"
                    android:padding="8dp"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/text_view_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginTop="16dp"
                android:textSize="36sp"
                android:textColor="#757575"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Include the numeric keypad -->
        <include layout="@layout/numeric_keypad" />

    </LinearLayout>
</LinearLayout>
