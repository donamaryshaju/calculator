<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true"
    tools:context=".HistoryActivity">

    <!-- The Toolbar for the back arrow and clear button -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/history_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:title="Calculation History"
        app:titleTextColor="@android:color/black"
        app:theme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- The list to show the calculations -->
    <ListView
        android:id="@+id/history_list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/history_toolbar"
        android:divider="@color/material_grey_300"
        android:dividerHeight="1dp" />

    <!-- A message to show when the history is empty -->
    <TextView
        android:id="@+id/empty_history_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No History Yet"
        android:textColor="@android:color/black"
        android:textSize="20sp"
        android:visibility="gone" />

</RelativeLayout>
